#!/usr/bin/env php
<?php

/**
 * phpsolidity - PHP smart contract transpiler CLI.
 *
 * All logic lives in PhpSolidity\Cli\Application so it can be tested.
 * Run `phpsolidity help` for usage.
 */

declare(strict_types=1);

$autoloadPaths = [
    $GLOBALS['_composer_autoload_path'] ?? '', // set by Composer's vendor/bin proxy (works with symlinked path repositories)
    __DIR__ . '/../vendor/autoload.php',       // running from a clone of this repository
    __DIR__ . '/../../../autoload.php',        // installed as a dependency: vendor/danielmabadeje/php-solidity/bin
    __DIR__ . '/../../autoload.php',
];

foreach ($autoloadPaths as $path) {
    if ($path !== '' && is_file($path)) {
        require $path;
        $autoloaded = true;
        break;
    }
}

if (! isset($autoloaded)) {
    fwrite(STDERR, "Autoloader not found. Run 'composer install' first.\n");
    exit(1);
}

exit((new PhpSolidity\Cli\Application())->run(array_slice($argv, 1)));
