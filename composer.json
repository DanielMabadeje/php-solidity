{
    "name": "danielmabadeje/php-solidity",
    "description": "Write Ethereum smart contracts in PHP: a PHP-to-Solidity transpiler",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ethereum",
        "solidity",
        "smart-contracts",
        "blockchain",
        "transpiler",
        "web3",
        "evm",
        "defi",
        "php"
    ],
    "homepage": "https://github.com/DanielMabadeje/php-solidity",
    "authors": [
        {
            "name": "Daniel Mabadeje",
            "email": "mabadejedaniel1@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/DanielMabadeje/php-solidity/issues",
        "source": "https://github.com/DanielMabadeje/php-solidity",
        "docs": "https://github.com/DanielMabadeje/php-solidity/tree/main/docs"
    },
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpSolidity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSolidity\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpsolidity"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ],
        "golden:update": [
            "@putenv UPDATE_GOLDEN=1",
            "phpunit --testsuite golden"
        ],
        "solc:check": [
            "php bin/phpsolidity compile tests/fixtures/contracts examples --output build/solidity --quiet",
            "node scripts/solc-check.js build/solidity"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite (unit + golden tests)",
        "analyse": "Run PHPStan at level 8",
        "check": "Static analysis and tests, as CI does",
        "golden:update": "Regenerate tests/fixtures/expected/*.sol after an intentional output change",
        "solc:check": "Compile every fixture and example, then verify the output with solc (needs Node.js and `npm install` in scripts/)"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
